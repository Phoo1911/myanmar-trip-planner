FROM node:22-bookworm-slim AS webbuild
WORKDIR /web
RUN corepack enable
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
ARG NEXT_PUBLIC_API_URL=/api
ARG NEXT_PUBLIC_DEMO_MODE=true
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL NEXT_PUBLIC_DEMO_MODE=$NEXT_PUBLIC_DEMO_MODE NEXT_TELEMETRY_DISABLED=1
RUN mkdir -p public && pnpm build

FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 libatomic1 && rm -rf /var/lib/apt/lists/*
COPY --from=webbuild /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ ./backend/
COPY deploy/start_free.py ./start_free.py
COPY --from=webbuild /web/.next/standalone ./web/
COPY --from=webbuild /web/.next/static ./web/.next/static/
COPY --from=webbuild /web/public ./web/public/
RUN useradd -m service
USER service
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=10000 API_INTERNAL_ORIGIN=http://127.0.0.1:8000
EXPOSE 10000
CMD ["python", "/app/start_free.py"]
